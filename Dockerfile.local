# ─────────────────────────────────────────────────────────────
# 로컬 개발용 Dockerfile — Jenkins 용 Dockerfile 과 분리해 유지한다.
#
# 원본과의 차이 (Jenkins → Local):
#   1) infisical CLI 설치·부팅 랩퍼 제거
#      → 로컬은 backend/.env 로 값이 이미 컨테이너에 주입되므로 불필요.
#        (Jenkins 는 사내 vault 에서 값을 조달해야 해서 infisical run 이 필요.)
#   2) ENTRYPOINT 를 entrypoint.sh 직접 호출로 단순화.
#   3) 나머지(3-stage 빌드·Nexus BuildKit secret·TLS 완화·SSH sshpass 도구)는 동일.
#
# 사용법 (docker-compose.local.yml 참고):
#   DOCKER_BUILDKIT=1 docker compose -f docker-compose.local.yml up -d --build
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Stage 1. Frontend build (Vite → frontend/dist)
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder
WORKDIR /workspace/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci

COPY frontend/ ./
# 관리자 가이드 정적 파일 — prebuild 스크립트가 ../docs/_build_v2 를 public/guide 로 복사한다.
COPY docs/_build_v2 /workspace/docs/_build_v2
RUN npm run build

# ─────────────────────────────────────────────────────────────
# Stage 2. Backend build (Gradle bootJar)
#   Nexus(사내 라이브러리) 인증은 원본과 동일하게 BuildKit secret 으로 주입.
#   로컬에서는 docker-compose.local.yml 이 backend/.env 의 NEXUS_USERNAME/PASSWORD 를
#   env 시크릿으로 전달한다.
# ─────────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jdk-jammy AS backend-builder
WORKDIR /workspace/backend

# 1) 의존성 해석 — build.gradle 이 안 바뀌면 이 레이어는 캐시됨.
COPY backend/build.gradle backend/settings.gradle* backend/gradlew ./
COPY backend/gradle ./gradle
RUN chmod +x gradlew
RUN --mount=type=secret,id=nexus_id \
    --mount=type=secret,id=nexus_pw \
    --mount=type=cache,target=/root/.gradle,sharing=locked \
    ./gradlew --no-daemon dependencies \
        -PnexusUsername="$(cat /run/secrets/nexus_id 2>/dev/null || true)" \
        -PnexusPassword="$(cat /run/secrets/nexus_pw 2>/dev/null || true)" \
    || true

# 2) 소스 복사 후 test → openapi3 → bootJar.
#   - test: 유닛 테스트 (Testcontainers 필요한 *IT 는 env 가드로 자동 스킵). 실패 시 이미지 빌드 실패.
#   - openapi3: 문서화 테스트가 만든 스니펫으로 OpenAPI 3 스펙 생성 → copyOpenApiToResources 가
#     src/main/resources/static/docs/openapi3.yaml 로 복사 → /docs/openapi3.yaml 로 서빙된다.
#   - bootJar: mustRunAfter 로 copy 뒤에 오도록 build.gradle 에서 강제. 그대로 이미지에 임베드.
# 관련: docs/api-docs-strategy.md
COPY backend/ ./
COPY --from=frontend-builder /workspace/frontend/dist /workspace/frontend/dist
RUN --mount=type=secret,id=nexus_id \
    --mount=type=secret,id=nexus_pw \
    --mount=type=cache,target=/root/.gradle,sharing=locked \
    ./gradlew --no-daemon --build-cache clean openapi3 bootJar \
        -PnexusUsername="$(cat /run/secrets/nexus_id 2>/dev/null || true)" \
        -PnexusPassword="$(cat /run/secrets/nexus_pw 2>/dev/null || true)"

# ─────────────────────────────────────────────────────────────
# Stage 3. Runtime — 로컬 단순화 버전 (infisical 없음)
# ─────────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-jammy AS runtime
WORKDIR /app

# 레거시 MSSQL(jtds) 등 TLSv1/1.1 만 지원하는 원격지 대비.
RUN sed -i 's/TLSv1, TLSv1.1,//g' $JAVA_HOME/conf/security/java.security

# 레거시 홈페이지 MariaDB SSH 터널용 도구만 설치 (infisical·curl·gnupg 제거).
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssh-client sshpass netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home /app app \
 && mkdir -p /app/.cache/stats \
 && chown -R app:app /app

COPY --from=backend-builder /workspace/backend/build/libs/*-SNAPSHOT.jar /app/app.jar
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER app

ENV SERVER_PORT=18080 \
    STATS_CACHE_DIR=/app/.cache/stats \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Seoul"

EXPOSE 18080

# 로컬은 backend/.env 로 값이 이미 들어와 있으므로 entrypoint.sh 를 직접 호출.
ENTRYPOINT ["/app/entrypoint.sh"]
