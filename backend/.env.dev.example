# ==================================================================
# backend/.env.dev — 팀 공용 개발서버 환경변수 템플릿 (gitignored)
#
# ⚠️ local/prod 와 공유 금지. dev 전용 시크릿을 새로 생성해 사용.
#
# EC2 서버 최초 1회:
#   cp backend/.env.dev.example backend/.env.dev
#   chmod 600 backend/.env.dev
#   vi backend/.env.dev                # 아래 값들을 실제 dev 값으로 교체
#
# 재배포:
#   git pull
#   docker compose -f docker-compose.dev.yml --env-file backend/.env.dev up -d --build
# ==================================================================

# ── Spring 프로파일 ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Postgres (같은 compose 의 컨테이너 — 외부 노출 안 함) ──────
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=<강력한 랜덤 비밀번호 - 예: openssl rand -base64 24>
# POSTGRES_URL 은 docker-compose.dev.yml 이 postgres:5432 로 덮어씀. 아래는 참고값.
POSTGRES_URL=jdbc:postgresql://postgres:5432/app

# ── JWT ──────────────────────────────────────────────────────────
# dev 전용 시크릿: openssl rand -base64 48 (local/prod 와 공유 금지)
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────────────
# dev 서버 도메인/IP. 쉼표로 복수 지정 가능.
APP_CORS_ALLOWED_ORIGINS=http://<dev-host>

# ── 최초 관리자 시드 ─────────────────────────────────────────────
# dev 는 데이터 리셋이 잦을 수 있어 편의상 true 유지도 OK
# (users 테이블 비어있을 때만 생성되므로 멱등).
APP_SEED_ENABLED=true
APP_SEED_ADMIN_LOGIN_ID=admin
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=<8자 이상>
APP_SEED_ADMIN_NAME=관리자
