# ==================================================================
# backend/.env — 로컬/도커 실행용 환경변수 템플릿 (단일 소스)
#
# 프로젝트 루트의 .env 는 backend/.env 로의 symlink.
# docker compose 는 루트 .env(symlink)에서 ${VAR} 치환을 하고,
# analytics 컨테이너의 env_file 도 같은 파일을 참조하므로 값 불일치가 없다.
#
# 사용법 (최초 1회):
#   cp backend/.env.example backend/.env
#   ln -sf backend/.env .env         # 루트 심볼릭 링크 생성 (macOS/Linux)
#
# 실행:
#   docker compose up -d                       # 기본 (홈페이지 MariaDB 는 BASTION_SSH_HOST 유무로 결정)
#   docker compose --profile mart up -d        # 앱 + 로컬 Postgres (도커 postgres 재활성 시)
#
# SSH 터널: analytics 컨테이너의 entrypoint 가 BASTION_SSH_HOST 가 설정된 경우 sshpass 로
# 컨테이너 내부에 127.0.0.1:13306 → 사내망 MariaDB 터널을 자동으로 연다(사이드카 없음).
#
# 참고 문서: docs/databatch/strategy.md · docs/databatch/legacy-homepage-source-strategy.md
# ==================================================================

# ── Spring 프로파일 ──────────────────────────────────────────────
# local  : 개인 개발 머신 (로컬 Docker Postgres, CRM 미접속, 배치 OFF)
# dev    : 팀 개발서버   (Dev Postgres, CRM read-only, 배치 스케줄 OFF · Admin 트리거만)
# prod   : 운영         (Prod Postgres, CRM read-only, 배치 스케줄 ON)
# 미지정 시 H2 인메모리 부팅.
SPRING_PROFILES_ACTIVE=local


# ── Postgres (Primary — 마트 조회 대상) ──────────────────────────
# 외부 개발 DB 를 사용한다(docker-compose 의 postgres 서비스는 비활성).
# 컨테이너에서 접속 시 host 를 host.docker.internal 로 잡아야 로컬 DB 에 닿는다.
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# 앱 → DB 접속 JDBC URL
#   컨테이너에서 로컬 DB 접속 : jdbc:postgresql://host.docker.internal:5432/analytics
#   호스트에서 gradle 실행    : jdbc:postgresql://localhost:5432/analytics
#   원격 개발 DB             : jdbc:postgresql://<host>:5432/analytics
POSTGRES_URL=jdbc:postgresql://host.docker.internal:5432/analytics


# ── CRM MSSQL (배치 전용 · 읽기 전용) ────────────────────────────
# 실 CRM DB — 도커라이즈 대상 아님. 읽기 계정으로만 접근.
STATS_DB_URL=jdbc:jtds:sqlserver://your-crm-host:1433/YourCrmDb
STATS_DB_USERNAME=readonly_user
STATS_DB_PASSWORD=change-me


# ── 아이리더 검사기록 MSSQL (검사통계 화면 · 읽기 전용) ──────────
# 비워두면 /api/eoeis-checkup 만 503으로 응답하고 앱은 정상 기동한다.
# 운영에서는 dbo.checkup_record / dbo.checkup_device_score SELECT 권한만 가진 계정을 사용한다.
EOEIS_DATASOURCE_URL=jdbc:jtds:sqlserver://your-eoeis-host:1433/EyeReader
EOEIS_DATASOURCE_USERNAME=readonly_user
EOEIS_DATASOURCE_PASSWORD=change-me


# ── 레거시 홈페이지 온라인 예약 소스 (예약자 리스트_홈페이지 화면) ──────
# 읽기 전용. 대시보드 DB 와 무관한 별도 소스라 프로파일이 아니라 이 값의 유무로 켜진다.
# 비워두면(기본) 관련 빈이 안 뜨고 /api/reservation-list-homepage 만 503 — 앱은 정상 기동한다.
#
# postgres-mart 프로파일에서는 이 소스가 mart_list_reservation_homepage 를 채우는 배치
# (ReservationListHomepageMartJob) 의 입력이 되고, 앱 조회는 마트에서 이뤄진다.
#
# 세 가지 사용 방식:
#
# [A] MariaDB 직결 (컨테이너 내부 SSH 터널 경유 — 권장)
#   analytics 컨테이너의 entrypoint 가 BASTION_SSH_HOST 가 설정되면 sshpass 로 터널을 연다.
#   앱은 컨테이너 안의 127.0.0.1:13306 을 통해 접속. 값은 로컬·dev·prod 어디서든 동일.
HOMEPAGE_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:13306/bseyecom_db
HOMEPAGE_DATASOURCE_USERNAME=bseyecom_user
HOMEPAGE_DATASOURCE_PASSWORD=change-me
#
# [B] SQLite 스냅샷 (호스트 직접 실행 시)
#   HOMEPAGE_DATASOURCE_URL=jdbc:sqlite:c:/workspace/php_home/bnviit-homepage-admin-rebuild/.cache/legacy-consultations.sqlite?open_mode=1
#   ?open_mode=1 = SQLITE_OPEN_READONLY (파일 레벨 읽기 전용)
#   도커에서 쓰려면 컨테이너 경로 + docker-compose.yml 의 HOMEPAGE_CACHE_FILE 마운트 필요:
#   HOMEPAGE_DATASOURCE_URL=jdbc:sqlite:/app/legacy/legacy-consultations.sqlite?open_mode=1
#   ※ 스냅샷 유효 범위 주의 — 마지막 등록일시 이후 구간은 건수가 조용히 모자라게 나온다.
#
# [C] 완전 비활성 (홈페이지 API 필요 없음)
#   HOMEPAGE_DATASOURCE_URL=


# ── SSH 터널 (컨테이너 내부 · [A] 사용 시) ───────────────────────
# analytics 컨테이너의 entrypoint.sh 가 이 값들을 읽어 sshpass 로 127.0.0.1:13306 →
# 사내망 MariaDB(bseyecom_db) 로 포워딩. 사이드카 없이 컨테이너 하나로 자립 동작.
# 계정 + 패스워드 인증 (sshpass). 키 인증으로 바꾸려면 Dockerfile 에 키 복사 후
# docker/entrypoint.sh 의 sshpass 라인 삭제 + -i 옵션 추가.
BASTION_SSH_HOST=your-bastion-host
BASTION_SSH_PORT=22
BASTION_SSH_USER=your-ssh-account
BASTION_SSH_PASSWORD=change-me
# 터널이 실제로 열 최종 목적지 (사내망 MariaDB). 기본값이 명시돼 있어 보통 주석 유지.
# HOMEPAGE_DB_HOST=192.168.200.32
# HOMEPAGE_DB_PORT=3306


# ── Nexus (사내 Maven 저장소) — 도커 이미지 빌드 시에만 필요 ─────
# Dockerfile 의 --mount=type=secret 이 docker-compose.yml 최상위 secrets 블록 경유로 읽는다.
# 젠킨스는 withCredentials 로 동일 이름의 환경변수를 만들어두면 그대로 통과.
NEXUS_USERNAME=change-me
NEXUS_PASSWORD=change-me


# ── JWT ──────────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열. openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-32-plus-character-secret
APP_JWT_EXPIRATION_MS=86400000


# ── CORS ─────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:18080


# ── H2 콘솔 / 관리자 시드 ───────────────────────────────────────
APP_H2_CONSOLE_ENABLED=false
APP_SEED_ENABLED=true
APP_SEED_ADMIN_LOGIN_ID=admin
APP_SEED_ADMIN_EMAIL=admin@bviit.com
APP_SEED_ADMIN_PASSWORD=change-me-for-local-login
APP_SEED_ADMIN_NAME=관리자


# ── 배치 스케줄러 (prod 프로파일만 실사용) ──────────────────────
# local/dev 는 프로파일 자체가 batch.mart.enabled=false 로 오버라이드하므로
# 아래 값은 사실상 prod 에서만 유효하다.
BATCH_MART_ENABLED=true
BATCH_MART_DAILY_CRON=0 0 3 * * *
# 월간 소급 재계산(전월 전체) — 현재 비활성. yml 의 monthly-reconcile-cron 을 조정해 재활성.
# BATCH_MART_MONTHLY_CRON=0 30 3 1 * *
# 예약통계(시력교정·백내장) 일별 마트만 오전 10시에 D-1 재실행 (콜센터 늦반영 흡수용)
BATCH_MART_RESERVATION_STATS_INTRADAY_CRON=0 0 10 * * *


# ── Slack 로그 알림 (dev/prod 프로파일에서 활성화) ──────────────
# com.visuworks.lib:slack-logger 가 지정된 level 이상 로그를 Slack 으로 전송.
# BatchOrchestrator 의 log.error("Batch failed: ...") 등이 자동 감지됨.
# LOGGING_SLACK_ENABLED / LEVEL 은 프로파일 기본값을 오버라이드할 때만 지정.
LOGGING_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXX/BXXX/XXXX
# LOGGING_SLACK_ENABLED=true
# LOGGING_SLACK_LEVEL=ERROR


# ── 서버/기타 ────────────────────────────────────────────────────
APP_PORT=18080


# ─── 솔라피(SOLAPI) 문자·알림톡 발송 — 문자 발송 관리 메뉴 ───
# 미설정 시 발송 API만 503 (화면·다른 기능 영향 없음)
#
# ⚠️ Dry-run 안전장치 — 기본 true 로 실제 알림톡·문자가 나가지 않는다(개발단계 안전).
#    · true  : SolapiSendService 가 API 호출 없이 SUCCESS 로 응답. 이력은 messageType=DRY_RUN 으로 남음
#    · false : 실제 솔라피 API 호출 (운영 발송)
#    운영 배포 전에만 false 로 명시적 해제 — 실수로 대량 발송을 막는다.
SOLAPI_DRY_RUN=true
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 계정에 등록된 발신번호 (01012345678 형식, 하이픈 없이)
SOLAPI_FROM=
# 카카오 비즈니스 채널 pfId — 알림톡 발송에 필수
SOLAPI_PFID=
# 템플릿 3종 슬롯: 알림톡 템플릿 ID + 문자 대체 본문(#{이름}·#{수술일} 치환 지원)
# 차수 라벨 (화면 컬럼명)
SOLAPI_TPL1_LABEL=수술 후 안내 1차
SOLAPI_TPL2_LABEL=수술 후 안내 2차
SOLAPI_TPL3_LABEL=수술 후 안내 3차

# ── 문구 슬롯 = 수술 그룹 5 × 차수 3 = 15 ──
# 수술마다 회복 속도가 달라 1차 시점과 안내 내용이 다르다(고객케어 TF 확정안 v5).
#   SMILE 스마일수술(스마일프로·스마일라식)  D+1 · D+7 · D+14
#   LASIK 라식                                D+1 · D+7 · D+14
#   ICL   렌즈삽입(ICL·KPL·VIVA)              D+3 · D+7 · D+14
#   LASEK 라섹 — 렌즈 제거 후라 가장 늦다     D+5 · D+7 · D+14
#   ETC   백내장·재수술·분류 실패분           D+1 · D+7 · D+14
# 오프셋은 코드(SurgeryGroup)가 갖는다. 여기서는 문구만 설정한다.
# 알림톡 ID 나 문자 본문 중 **하나 이상**을 채워야 그 슬롯이 발송된다.
# 비워 두면 그 그룹은 발송되지 않는다 — 조용히 남의 문구가 나가는 것보다 안 나가는 편이 안전하다.
#
# _SMS_DELAYED (2·3차만) — **기준일이 재조정된 대상**에게 나가는 문자 본문이다.
#   홀딩 해제·연락처 수정으로 발송이 밀리면 "수술 후 일주일이 지났습니다"가 거짓이 되므로,
#   그 경과 선언을 뺀 본문을 따로 둔다. 지연 건은 알림톡을 쓰지 않는다(변형 문구는 카카오 심사가 또 필요).
#   1차는 경과 선언이 없어 지연 본문이 필요 없다 — 기본 본문을 그대로 쓴다.
#   비워 두면 재조정된 대상에게는 그 차수가 발송되지 않는다.
SOLAPI_TPL_SMILE_1_ID=
SOLAPI_TPL_SMILE_1_SMS=
SOLAPI_TPL_SMILE_2_ID=
SOLAPI_TPL_SMILE_2_SMS=
SOLAPI_TPL_SMILE_2_SMS_DELAYED=
SOLAPI_TPL_SMILE_3_ID=
SOLAPI_TPL_SMILE_3_SMS=
SOLAPI_TPL_SMILE_3_SMS_DELAYED=
SOLAPI_TPL_LASIK_1_ID=
SOLAPI_TPL_LASIK_1_SMS=
SOLAPI_TPL_LASIK_2_ID=
SOLAPI_TPL_LASIK_2_SMS=
SOLAPI_TPL_LASIK_2_SMS_DELAYED=
SOLAPI_TPL_LASIK_3_ID=
SOLAPI_TPL_LASIK_3_SMS=
SOLAPI_TPL_LASIK_3_SMS_DELAYED=
SOLAPI_TPL_LASEK_1_ID=
SOLAPI_TPL_LASEK_1_SMS=
SOLAPI_TPL_LASEK_2_ID=
SOLAPI_TPL_LASEK_2_SMS=
SOLAPI_TPL_LASEK_2_SMS_DELAYED=
SOLAPI_TPL_LASEK_3_ID=
SOLAPI_TPL_LASEK_3_SMS=
SOLAPI_TPL_LASEK_3_SMS_DELAYED=
SOLAPI_TPL_ICL_1_ID=
SOLAPI_TPL_ICL_1_SMS=
SOLAPI_TPL_ICL_2_ID=
SOLAPI_TPL_ICL_2_SMS=
SOLAPI_TPL_ICL_2_SMS_DELAYED=
SOLAPI_TPL_ICL_3_ID=
SOLAPI_TPL_ICL_3_SMS=
SOLAPI_TPL_ICL_3_SMS_DELAYED=
SOLAPI_TPL_ETC_1_ID=
SOLAPI_TPL_ETC_1_SMS=
SOLAPI_TPL_ETC_2_ID=
SOLAPI_TPL_ETC_2_SMS=
SOLAPI_TPL_ETC_2_SMS_DELAYED=
SOLAPI_TPL_ETC_3_ID=
SOLAPI_TPL_ETC_3_SMS=
SOLAPI_TPL_ETC_3_SMS_DELAYED=
