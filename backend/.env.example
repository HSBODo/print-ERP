# ==================================================================
# backend/.env — 로컬/도커 실행용 환경변수 템플릿 (단일 소스)
#
# 프로젝트 루트의 .env 는 backend/.env 로의 symlink.
# docker compose 는 루트 .env(symlink)에서 ${VAR} 치환을 하고,
# analytics 컨테이너의 env_file 도 같은 파일을 참조하므로 값 불일치가 없다.
#
# 사용법 (최초 1회):
#   cp backend/.env.example backend/.env
#   ln -sf backend/.env .env         # 루트 심볼릭 링크 생성 (macOS/Linux)
#
# 실행:
#   docker compose up -d                       # 기본
#   docker compose --profile mart up -d        # 앱 + 로컬 Postgres (도커 postgres 재활성 시)
#
# 참고 문서: docs/databatch/strategy.md · docs/data-platform/external-db-decommission.md
# ==================================================================

# ── Spring 프로파일 ──────────────────────────────────────────────
# local  : 개인 개발 머신 (로컬 Docker Postgres, 배치 OFF)
# dev    : 팀 개발서버   (Dev Postgres + warehouse, Admin 수동 배치)
# prod   : 운영         (Prod Postgres + warehouse, 매일 배치 + 월 재계산)
# ⚠ 반드시 셋 중 하나를 설정 — 미지정 시 datasource 미구성으로 기동 실패 (의도적 가드).
SPRING_PROFILES_ACTIVE=local


# ── Postgres (Primary — 마트 조회 대상) ──────────────────────────
# 외부 개발 DB 를 사용한다(docker-compose 의 postgres 서비스는 비활성).
# 컨테이너에서 접속 시 host 를 host.docker.internal 로 잡아야 로컬 DB 에 닿는다.
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me
# 포트 — 앱은 POSTGRES_URL 로 접속하므로 필수 아님. docker-compose 의 postgres 컨테이너
# 포트 매핑 또는 배포 스크립트가 참조하는 값이면 여기에 명시한다. 미사용 시 삭제 가능.
POSTGRES_PORT=5432
# 앱 → DB 접속 JDBC URL
#   컨테이너에서 로컬 DB 접속 : jdbc:postgresql://host.docker.internal:5432/analytics
#   호스트에서 gradle 실행    : jdbc:postgresql://localhost:5432/analytics
#   원격 개발 DB             : jdbc:postgresql://<host>:5432/analytics
POSTGRES_URL=jdbc:postgresql://host.docker.internal:5432/analytics


# ── Data warehouse (RDS Postgres · 데이터 플랫폼) ────────────────
# 통계 조회는 전부 이 warehouse(raw.* + mart) 에서 이뤄진다.
# 미설정 시 warehouse.datasource.url 이 dummy 로 폴백되어 앱은 정상 기동하되 조회 시점에 실패.
WAREHOUSE_HOST=your-rds-host.ap-northeast-2.rds.amazonaws.com
WAREHOUSE_PORT=5432
WAREHOUSE_DB=bnviit_datawarehouse
WAREHOUSE_USERNAME=readonly_user
WAREHOUSE_PASSWORD=change-me

# ── 해외마케팅 접수리스트 Google Sheet 동기화 (선택) ──────────
# 시트 → 마트 전체 동기화 버튼을 켤 때만 필요.
# 서비스 계정 JSON 중 하나(base64 또는 컨테이너 내부 파일)가 필요하다. 기본은 꺼짐(이관 완료 후 수기 입력만 사용).
OVERSEAS_GOOGLE_SHEETS_SYNC_ENABLED=false
OVERSEAS_GOOGLE_CREDENTIALS_BASE64=
OVERSEAS_GOOGLE_CREDENTIALS_FILE=
OVERSEAS_GOOGLE_SPREADSHEET_ID=1IaVjs1priY7ccqS9SwZ1X4wmwyN7_aDlonD7dEL-p8A
OVERSEAS_GOOGLE_RANGE=2026!A5:V

# ── 해외마케팅 CRM 매칭 자동 스케줄러 (2026-09-11 도입) ────────
# true 로 켜면 매일 새벽 3시(기본)에 sync-crm 잡 자동 실행 — 담당자 수동 클릭 불필요.
# 문제 발생 시 false 로 즉시 중단 가능. 시각 조정은 OVERSEAS_CRM_SYNC_CRON.
# 기본 OFF (도입 초기 안전장치).
OVERSEAS_CRM_SYNC_SCHEDULER_ENABLED=false
OVERSEAS_CRM_SYNC_CRON=0 0 3 * * *


# ── Nexus (사내 Maven 저장소) — 도커 이미지 빌드 시에만 필요 ─────
# Dockerfile 의 --mount=type=secret 이 docker-compose.yml 최상위 secrets 블록 경유로 읽는다.
# 젠킨스는 withCredentials 로 동일 이름의 환경변수를 만들어두면 그대로 통과.
NEXUS_USERNAME=change-me
NEXUS_PASSWORD=change-me


# ── JWT ──────────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열. openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-32-plus-character-secret
APP_JWT_EXPIRATION_MS=86400000


# ── CORS ─────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:18080


# ── 관리자 시드 ───────────────────────────────────────────────
APP_SEED_ENABLED=true
APP_SEED_ADMIN_LOGIN_ID=admin
APP_SEED_ADMIN_EMAIL=admin@bviit.com
APP_SEED_ADMIN_PASSWORD=change-me-for-local-login
APP_SEED_ADMIN_NAME=관리자


# ── 배치 스케줄러 (prod 프로파일만 실사용) ──────────────────────
# local/dev 는 프로파일 자체가 batch.mart.enabled=false 로 오버라이드하므로
# 아래 값은 사실상 prod 에서만 유효하다.
BATCH_MART_ENABLED=true
BATCH_MART_DAILY_CRON=0 0 3 * * *
# 월간 소급 재계산(전월 전체) — 매월 1일 03:30 KST. list_reservation 이 등록일 기준이라
# 며칠 지나 상태(취소·수정)가 바뀐 예약을 매일 배치가 놓치는데, 이 잡이 그 소급 변동을 흡수한다.
# ⚠️ 매월 1일 03:30 은 OVERSEAS_CRM_SYNC_CRON 기본값(0 30 3 * * *)과 정확히 겹친다.
# CRM 매칭 스케줄러도 켠 환경에서는 CRM sync 를 04:00 등으로 미뤄 MSSQL 풀 병목을 피한다.
BATCH_MART_MONTHLY_RECONCILE_CRON=0 30 3 1 * *
# 예약통계(시력교정·백내장) 일별 마트만 오전 10시에 D-1 재실행 (콜센터 늦반영 흡수용)
BATCH_MART_RESERVATION_STATS_INTRADAY_CRON=0 0 10 * * *
# 배치가 처리할 최소 연도. D-1 이 이 값 미만이면 skip (실행은 하되 아무 데이터 안 읽음).
BATCH_MART_MIN_YEAR=2026


# ── Slack 로그 알림 (dev/prod 프로파일에서 활성화) ──────────────
# com.visuworks.lib:slack-logger 가 지정된 level 이상 로그를 Slack 으로 전송.
# BatchOrchestrator 의 log.error("Batch failed: ...") 등이 자동 감지됨.
# 로컬은 false 로 시작하고, dev/prod 배포 시 true 로 조정.
LOGGING_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXX/BXXX/XXXX
LOGGING_SLACK_ENABLED=false
LOGGING_SLACK_LEVEL=ERROR


# ── 서버/기타 ────────────────────────────────────────────────────
APP_PORT=18080


# ── SMS 자동발송 배치 (postgres-mart 프로파일 전용) ──────────────
# 5분 폴러가 sms_dispatch_queue 를 잡아 SolapiSendService 로 넘긴다.
# 운영 활성화 순서: (1) SMS_DISPATCH_ENABLED=true (2) SOLAPI_DRY_RUN=false.
# 아래는 전부 application.yml 기본값과 동일 — 값 조정 시에만 편집하면 된다.
SMS_DISPATCH_ENABLED=false
# 폴러 크론 (Asia/Seoul). 기본 5분마다. "-" 로 하면 스케줄러 미등록.
SMS_DISPATCH_CRON=0 */5 * * * *
# 한 사이클에 잡는 최대 큐 개수 (FOR UPDATE SKIP LOCKED LIMIT).
SMS_DISPATCH_BATCH_SIZE=50
# 하루 최대 발송량 (RECEIVED+DONE 합산). 초과 시 사이클 skip.
SMS_DISPATCH_DAILY_LIMIT=500
# 큐 행당 재시도 상한. 도달 시 FAILED 로 굳어 관리자 [실패 재실행] 로만 되살아남.
SMS_DISPATCH_MAX_ATTEMPTS=3
# 광고톡 발송 허용 시(hour) — 정보통신망법상 21~08 금지. 알림톡은 시간 제한 없음.
SMS_DISPATCH_AD_START_HOUR=8
SMS_DISPATCH_AD_END_HOUR=20
# FAILED 큐 누적이 임계치 이상이면 Slack 경고 (상승 엣지에서만). 0 이하면 알림 비활성.
# 매 5분 사이클마다 시끄럽지 않게 임계치 진입 시 한 번, 관리자가 [실패 재실행] 으로 밑까지 내리면 리셋된다.
SMS_DISPATCH_FAILED_ALERT_THRESHOLD=10


# ─── 솔라피(SOLAPI) 문자·알림톡 발송 — 문자 발송 관리 메뉴 ───
# 미설정 시 발송 API만 503 (화면·다른 기능 영향 없음)
#
# ⚠️ Dry-run 안전장치 — 기본 true 로 실제 알림톡·문자가 나가지 않는다(개발단계 안전).
#    · true  : SolapiSendService 가 API 호출 없이 SUCCESS 로 응답. 이력은 messageType=DRY_RUN 으로 남음
#    · false : 실제 솔라피 API 호출 (운영 발송)
#    운영 배포 전에만 false 로 명시적 해제 — 실수로 대량 발송을 막는다.
SOLAPI_DRY_RUN=true
# 수신자 강제 대체 — dry-run=true 안에서만 유효.
#   · 비어 있음: 기존 dry-run 동작 (API 미호출, 로그만)
#   · 값 있음  : 실 솔라피 API 호출하되 수신자를 이 번호로만 강제 ("내 폰으로만 나가게" 검증 패턴)
#   · dry-run=false 이면 무시 (운영에서 잔존해도 원 수신자로 정상 발송)
# 형식은 하이픈 없는 010… (예: 01012345678)
SOLAPI_OVERRIDE_TO=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 계정에 등록된 발신번호 (01012345678 형식, 하이픈 없이)
SOLAPI_FROM=
# 카카오 비즈니스 채널 pfId — 알림톡 발송에 필수
SOLAPI_PFID=
# 웹훅(SINGLE-REPORT) 서명 검증용 시크릿 — 솔라피 콘솔에서 웹훅 등록 시
# secret 필드에 넣은 문자열과 동일해야 한다(무작위 32자+ 권장). 검증 방식은
# 헤더 X-Solapi-Secret 값과 이 시크릿을 시간 상수로 **직접 비교**(2026-09-01 확인:
# 솔라피 payload 는 원본 시크릿을 그대로 실어보내며, Node 예시의 sha1 는 안 씀).
# 비어 있으면 검증 skip(로컬용) — 운영은 반드시 채울 것(안 그러면 누구든 발송 상태를 조작할 수 있다).
SOLAPI_WEBHOOK_SECRET=
# fallback 동기화 크론 — 웹훅 유실·비활성 대비. 기본은 하루 1회 새벽 3:30 최근 2일 재확인.
# 정상 운영이면 갱신 0건이 정상. 개발·검증 환경에서는 매 15분(0 */15 * * * *)으로 짧게 잡아
# 웹훅 문제를 빠르게 감지하기도 함. 비활성 필요 시 "-" (Spring 이 스케줄 미등록).
SOLAPI_SYNC_CRON=0 30 3 * * *
# 템플릿 3종 슬롯: 알림톡 템플릿 ID + 문자 대체 본문(#{이름}·#{수술일} 치환 지원)
# 차수 라벨 (화면 컬럼명)
SOLAPI_TPL1_LABEL=수술 후 안내 1차
SOLAPI_TPL2_LABEL=수술 후 안내 2차
SOLAPI_TPL3_LABEL=수술 후 안내 3차

# ── 문구 슬롯 = 수술 그룹 5 × 차수 3 = 15 ──
# 수술마다 회복 속도가 달라 1차 시점과 안내 내용이 다르다(고객케어 TF 확정안 v5).
#   SMILE 스마일수술(스마일프로·스마일라식)  D+1 · D+7 · D+14
#   LASIK 라식                                D+1 · D+7 · D+14
#   ICL   렌즈삽입(ICL·KPL·VIVA)              D+3 · D+7 · D+14
#   LASEK 라섹 — 렌즈 제거 후라 가장 늦다     D+5 · D+7 · D+14
#   ETC   백내장·재수술·분류 실패분           D+1 · D+7 · D+14
# 오프셋은 코드(SurgeryGroup)가 갖는다. 여기서는 문구만 설정한다.
# 알림톡 ID 나 문자 본문 중 **하나 이상**을 채워야 그 슬롯이 발송된다.
# 비워 두면 그 그룹은 발송되지 않는다 — 조용히 남의 문구가 나가는 것보다 안 나가는 편이 안전하다.
#
# _SMS_DELAYED (2·3차만) — **기준일이 재조정된 대상**에게 나가는 문자 본문이다.
#   홀딩 해제·연락처 수정으로 발송이 밀리면 "수술 후 일주일이 지났습니다"가 거짓이 되므로,
#   그 경과 선언을 뺀 본문을 따로 둔다. 지연 건은 알림톡을 쓰지 않는다(변형 문구는 카카오 심사가 또 필요).
#   1차는 경과 선언이 없어 지연 본문이 필요 없다 — 기본 본문을 그대로 쓴다.
#   비워 두면 재조정된 대상에게는 그 차수가 발송되지 않는다.
SOLAPI_TPL_SMILE_1_ID=
SOLAPI_TPL_SMILE_2_ID=
SOLAPI_TPL_SMILE_3_ID=

SOLAPI_TPL_LASIK_1_ID=
SOLAPI_TPL_LASIK_2_ID=
SOLAPI_TPL_LASIK_3_ID=

SOLAPI_TPL_LASEK_1_ID=
SOLAPI_TPL_LASEK_2_ID=
SOLAPI_TPL_LASEK_3_ID=

SOLAPI_TPL_ICL_1_ID=
SOLAPI_TPL_ICL_2_ID=
SOLAPI_TPL_ICL_3_ID=

# 지연 발송용 문자 본문 (2·3차) — 기준일이 재조정된 대상에게 나가는 파생본.
# 원본: frontend/src/pages/sms/smsTemplateTexts.ts (DELAYED_TEXTS)
# 개행은 \n 으로 표기 — docker compose env_file 은 escape 미해석이라 백엔드가 변환한다.
# 미설정 시 재조정된 대상의 그 차수는 발송 skip (조용히 잘못된 문구가 나가는 것보다 안전).
SOLAPI_TPL_SMILE_2_SMS_DELAYED=#{name}님, 오늘부터는 조깅, 스트레칭 같은 가벼운 운동과 수영이 가능합니다.\n\n궁금한 점이 있다면 비앤빛으로 연락주세요.
SOLAPI_TPL_SMILE_3_SMS_DELAYED=#{name}님, 심한 운동(격투기, 구기종목 등), 파마·염색은 수술 1개월 후부터 가능하니 참고해 주세요.\n\n다음 정기 진료를 잊지 말고 챙겨주시기 바라며, 궁금한 점이 있다면 비앤빛으로 연락주세요.

SOLAPI_TPL_LASIK_2_SMS_DELAYED=#{name}님, 오늘부터는 조깅, 스트레칭 같은 가벼운 운동과 눈 화장이 가능합니다.\n\n대중목욕탕·사우나·수영은 수술 2주 후부터 가능하니 참고해 주세요.\n\n궁금한 점이 있다면 비앤빛으로 연락주세요.
SOLAPI_TPL_LASIK_3_SMS_DELAYED=#{name}님, 이제 대중목욕탕·사우나·수영이 가능합니다.\n\n파마·염색, 심한 운동(격투기, 구기종목 등)은 수술 1개월 후부터 가능하니 참고해 주세요.\n\n다음 정기 진료를 잊지 말고 챙겨주시기 바라며, 궁금한 점이 있다면 비앤빛으로 연락주세요.

SOLAPI_TPL_LASEK_2_SMS_DELAYED=#{name}님, 오늘부터는 조깅, 스트레칭 같은 가벼운 운동이 가능합니다.\n\n눈 화장, 대중목욕탕 이용은 수술 2주 후부터 가능하며, 자외선 차단은 수술 후 6개월간 꾸준히 챙겨주시기 바랍니다.\n\n궁금한 점이 있다면 비앤빛으로 연락주세요.
SOLAPI_TPL_LASEK_3_SMS_DELAYED=#{name}님, 이제 눈화장, 수영, 사우나가 가능합니다.\n\n파마·염색, 심한 운동(격투기, 구기종목 등)은 수술 1개월 후부터 가능하니 참고해 주세요.\n자외선 차단은 수술 후 6개월간 계속 챙겨주시기 바랍니다.\n\n다음 정기 진료를 잊지 말고 챙겨주시기 바라며, 궁금한 점이 있다면 비앤빛으로 연락주세요.

SOLAPI_TPL_ICL_2_SMS_DELAYED=#{name}님, 오늘부터는 조깅, 스트레칭 같은 가벼운 운동과 머리를 숙이는 자세가 가능합니다.\n\n수영은 수술 1개월 후부터 가능하니 참고해 주세요.\n\n궁금한 점이 있다면 비앤빛으로 연락주세요.
SOLAPI_TPL_ICL_3_SMS_DELAYED=#{name}님, 대중목욕탕 및 사우나, 파마·염색, 눈화장, 수영, 심한 운동(구기종목 등)은 수술 1개월 후부터 가능하니 참고해 주세요.\n\n다음 정기 진료를 잊지 말고 챙겨주시기 바라며, 궁금한 점이 있다면 비앤빛으로 연락주세요.



