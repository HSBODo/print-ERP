# ==================================================================
# backend/.env — 로컬/도커 실행용 환경변수 템플릿
#
# 최초 1회:
#   cp backend/.env.example backend/.env    # 값 채우기 (backend/.env 는 gitignored)
#
# 실행:
#   docker compose up -d --build            # 앱 + Postgres
#   docker compose up -d postgres           # DB 만 띄우고 백엔드는 gradle bootRun
# ==================================================================

# ── Spring 프로파일 (local | dev | prod) ─────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Postgres ─────────────────────────────────────────────────────
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# 앱 → DB 접속 JDBC URL
#   호스트에서 gradle 실행 : jdbc:postgresql://localhost:5432/app
#   docker compose 안에서는 docker-compose.yml 이 postgres 컨테이너로 덮어쓴다.
POSTGRES_URL=jdbc:postgresql://localhost:5432/app

# ── JWT ──────────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열. openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-32-plus-character-secret
APP_JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:18080,http://localhost:15173

# ── 최초 관리자 시드 (users 테이블이 비어 있을 때만 1회 생성) ──────
APP_SEED_ENABLED=true
APP_SEED_ADMIN_LOGIN_ID=admin
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=change-me-for-local-login
APP_SEED_ADMIN_NAME=관리자

# ── 서버 ─────────────────────────────────────────────────────────
APP_PORT=18080
