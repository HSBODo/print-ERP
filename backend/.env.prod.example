# ==================================================================
# backend/.env.prod — EC2 운영 환경변수 템플릿
#
# ⚠️ 로컬 backend/.env 와 절대 공유 금지. 운영 전용 시크릿을 새로 생성해 사용.
#
# EC2 서버 최초 1회:
#   cp backend/.env.prod.example backend/.env.prod
#   chmod 600 backend/.env.prod
#   vi backend/.env.prod   # 아래 값들을 실제 운영 값으로 교체
#
# 재배포:
#   git pull
#   docker compose -f docker-compose.prod.yml --env-file backend/.env.prod up -d --build
# ==================================================================

# ── Spring 프로파일 ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Postgres (같은 compose 의 컨테이너 — 외부 노출 안 함) ──────
# POSTGRES_URL 은 docker-compose.prod.yml 에서 postgres 서비스명으로 덮어쓰기 때문에
# 여기 값은 참고용. 실제로는 포트/호스트 부분이 "postgres:5432" 로 바뀜.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=<강력한 랜덤 비밀번호 - 예: openssl rand -base64 24>
POSTGRES_URL=jdbc:postgresql://postgres:5432/app

# ── JWT ──────────────────────────────────────────────────────────
# 운영 전용 시크릿을 새로 생성: openssl rand -base64 48
# 로컬 개발에서 쓰던 값 재사용 절대 금지.
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────────────
# 실제 운영 도메인만 허용. 쉼표로 복수 지정 가능.
# 도메인 없이 EC2 public IP 로 접근한다면: http://<ec2-public-ip>
APP_CORS_ALLOWED_ORIGINS=http://<ec2-public-ip-또는-도메인>

# ── 최초 관리자 시드 ─────────────────────────────────────────────
# 1단계: 첫 배포 때 APP_SEED_ENABLED=true + APP_SEED_ADMIN_PASSWORD(8자+)
# 2단계: admin 로그인 확인 후 APP_SEED_ENABLED=false 로 되돌리고 재배포
# (users 테이블이 비어 있을 때만 생성되므로 true 유지도 안전은 하지만,
#  시크릿을 env 에 남기는 것 자체가 리스크라 false 권장)
APP_SEED_ENABLED=false
APP_SEED_ADMIN_LOGIN_ID=admin
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=
APP_SEED_ADMIN_NAME=관리자
