# ==================================================================
# backend/.env.local — 로컬 개발용 환경변수 템플릿 (gitignored)
#
# 최초 1회:
#   cp backend/.env.local.example backend/.env.local
#   openssl rand -base64 48            # → APP_JWT_SECRET 에 붙이기
#
# 실행:
#   docker compose -f docker-compose.local.yml --env-file backend/.env.local up -d --build
#   docker compose -f docker-compose.local.yml --env-file backend/.env.local up -d postgres
#     → DB 만 띄우고 백엔드는 ./gradlew :backend:bootRun 로 개발
# ==================================================================

# ── Spring 프로파일 (local | dev | prod) ─────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Postgres ─────────────────────────────────────────────────────
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
# 호스트 바인딩 포트. 로컬에 다른 Postgres 가 5432 쓰고 있을 수 있어 15432 로 둔다.
POSTGRES_PORT=15432
# 앱 → DB 접속 JDBC URL
#   호스트에서 gradle 실행 : jdbc:postgresql://localhost:15432/app
#   docker compose 안에서는 docker-compose.yml 이 postgres 컨테이너로 덮어쓴다.
POSTGRES_URL=jdbc:postgresql://localhost:15432/app

# ── JWT ──────────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열. openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-32-plus-character-secret
APP_JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:18080,http://localhost:15173

# ── 최초 관리자 시드 (users 테이블이 비어 있을 때만 1회 생성) ──────
APP_SEED_ENABLED=true
APP_SEED_ADMIN_LOGIN_ID=admin
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=change-me-for-local-login
APP_SEED_ADMIN_NAME=관리자

# ── 서버 ─────────────────────────────────────────────────────────
APP_PORT=18080
