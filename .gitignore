.vscode/
*.bundle
frontend/.env
.env
# 프로필별 환경변수 파일 (local/dev/prod 공통) — 시크릿 포함, 절대 커밋 금지
backend/.env.local
backend/.env.dev
backend/.env.prod
*.log
.cache/
backend/.cache/

# Gradle 산출물 — 루트에 `settings.gradle` 이 있어 `./backend/gradlew` 실행 시 루트에도 생성됨.
.gradle/
build/

# Gradle 로컬 설정 — 개인 계정·토큰이 들어갈 수 있어 커밋 금지.
gradle.properties

# docker compose 로컬 오버라이드 — 호스트 경로·개인 설정이 들어간다(머신마다 다름).
docker-compose.override.yml

# 로컬 데이터 파일 (Excel 원본/Office 잠금파일)
*.xlsx
~$*

# 운영 자격증명이 남을 수 있는 .env 백업
.env.bak*

# API 문서 스펙 — ./gradlew test openapi3 가 매 빌드마다 새로 만드는 산출물.
backend/src/main/resources/static/docs/openapi3.yaml

# 개인 IDE·에이전트 설정 — 템플릿 사용자마다 다르다
.idea/
.claude/settings.local.json
