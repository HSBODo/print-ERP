.vscode/
.frontend-git-backup/
frontend/.git.frontend-backup/
*.bundle
frontend/.env
.env
*.log
.omx/
.cache/
backend/.cache/

# Gradle 로컬 설정 — Nexus 계정(nexusUsername/nexusPassword)이 들어가는 파일이다. 커밋 금지.
# 계정은 리포 밖(~/.gradle/gradle.properties)에 두는 게 원칙 — 리포 안에는 만들지 말 것.
# 이 패턴은 방어용이다(실수로 리포에 만들어도 스테이징되지 않게).
gradle.properties

# docker compose 로컬 오버라이드 — 호스트 경로·개인 설정이 들어간다(머신마다 다름).
docker-compose.override.yml

# 로컬 데이터 파일 (Excel 원본/Office 잠금파일)
*.xlsx
~$*

# 예약통계 확정 스냅샷 — 런타임 생성분은 커밋 제외, PDF 고정(locked) 시드만 추적
backend/data/*
!backend/data/reservation-stats/
backend/data/reservation-stats/*
!backend/data/reservation-stats/2026-01.json
!backend/data/reservation-stats/2026-02.json
!backend/data/reservation-stats/2026-03.json
!backend/data/reservation-stats/2026-04.json
!backend/data/reservation-stats/2026-05.json
!backend/data/reservation-stats/2026-06.json
!backend/data/reservation-stats-cataract/
backend/data/reservation-stats-cataract/*
!backend/data/reservation-stats-cataract/2026-01.json
!backend/data/reservation-stats-cataract/2026-02.json
!backend/data/reservation-stats-cataract/2026-03.json
!backend/data/reservation-stats-cataract/2026-04.json
!backend/data/reservation-stats-cataract/2026-05.json
!backend/data/reservation-stats-cataract/2026-06.json
data/reservation-stats/

# 운영 자격증명이 남을 수 있는 .env 백업
.env.bak*
