.vscode/
.frontend-git-backup/
frontend/.git.frontend-backup/
*.bundle
frontend/.env
.env
*.log
.omx/
.cache/
backend/.cache/

# Gradle 로컬 설정 — Nexus 계정(nexusUsername/nexusPassword)이 들어가는 파일이다. 커밋 금지.
# 계정은 리포 밖(~/.gradle/gradle.properties)에 두는 게 원칙 — 리포 안에는 만들지 말 것.
# 이 패턴은 방어용이다(실수로 리포에 만들어도 스테이징되지 않게).
gradle.properties

# docker compose 로컬 오버라이드 — 호스트 경로·개인 설정이 들어간다(머신마다 다름).
docker-compose.override.yml

# 로컬 데이터 파일 (Excel 원본/Office 잠금파일)
*.xlsx
~$*

# (2026-08-26 삭제) backend/data/ 예약통계 스냅샷 JSON 12개 · MonthlySnapshotStore 정리 —
#   V19/V20 시드가 마트 SSOT 로 이관됨. 관련 예외 규칙 제거.

# 운영 자격증명이 남을 수 있는 .env 백업
.env.bak*

# D/L 장부 스프레드시트 원본 export — 환자 실명·고객번호가 들어 있어 커밋 금지.
# (docs/databatch/*.csv 는 집계값이라 추적 대상이므로 *.csv 로 싸잡지 않는다)
/D_L 장부들*.csv

# API 문서 스펙 — ./gradlew test openapi3 가 매 빌드마다 새로 만드는 산출물.
# 배포 파이프라인·전략은 docs/api-docs-strategy.md 참조.
backend/src/main/resources/static/docs/openapi3.yaml

# 관리자 가이드 — frontend 빌드 시 docs/_build_v2 에서 동기화(prebuild 스크립트).
# 원본은 docs/_build_v2 (커밋됨). 여기 두면 중복이라 배제.
frontend/public/guide/
